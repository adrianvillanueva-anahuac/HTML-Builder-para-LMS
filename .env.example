GEMINI_API_KEY=

# Modelo compatible con salida JSON estructurada y disponible en tu proyecto.
# Consulta sus precios/cuotas antes de utilizarlo. No usar prefijo VITE_ para claves.
GEMINI_MODEL=

# Identificadores OAuth públicos; nunca poner secretos de cliente o tokens aquí.
# Google Cloud: cliente Web, Drive API activada, scope drive.readonly.
VITE_GOOGLE_CLIENT_ID=
# Microsoft Entra: cliente SPA, permiso delegado Microsoft Graph Files.Read.
VITE_MICROSOFT_CLIENT_ID=
# common: organizaciones y cuentas personales (si el registro las admite).
# Para limitar a una institución, usar su Tenant ID.
VITE_MICROSOFT_TENANT_ID=common
